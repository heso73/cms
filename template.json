{
  "_cms_template_version": "2.0",
  "_cms_instructions": {
    "usage": "Copy this file, remove all keys starting with '_', fill in your values, validate at https://validator.schema.org/",
    "required_fields": ["@context", "@type", "name"],
    "language_codes": "Use BCP 47 only — ht (Haitian Creole), gcf (Guadeloupe Creole), jam (Jamaican Patois), fr (French), en (English), es (Spanish)",
    "cms_namespace": "https://caribbeanmetadata.org/ns/",
    "certification_levels": ["Bronze", "Silver", "Gold", "Platinum"],
    "validator": "https://validator.schema.org/",
    "documentation": "https://caribbeanmetadata.org"
  },

  "@context": {
    "@vocab": "https://schema.org/",
    "cms": "https://caribbeanmetadata.org/ns/"
  },

  "_section_1": "=== SCHEMA.ORG CORE FIELDS (standard — required) ===",

  "@type": "CreativeWork",
  "_type_options": ["CreativeWork", "Movie", "MusicRecording", "TVSeries", "Podcast", "Book", "ShortStory", "VideoObject"],

  "name": "YOUR_CONTENT_TITLE",

  "description": "A short description of your content (1–3 sentences).",

  "creator": {
    "@type": "Person",
    "name": "YOUR_NAME",
    "sameAs": "https://your-website-or-social-profile.com"
  },

  "datePublished": "YYYY-MM-DD",

  "inLanguage": "LANGUAGE_CODE_BCP47",
  "_inLanguage_note": "BCP 47 required. Examples: ht, gcf, jam, fr, en, es. Do NOT use ISO 639-3 codes (hat, fra) here.",

  "keywords": [
    "KEYWORD_1",
    "KEYWORD_2",
    "KEYWORD_3"
  ],
  "_keywords_note": "Use lowercase, hyphenated. Include territory, genre, and cultural markers. These feed platform search and recommendation engines.",

  "contentLocation": {
    "@type": "Place",
    "name": "TERRITORY_NAME",
    "addressCountry": "ISO_3166_COUNTRY_CODE"
  },
  "_contentLocation_note": "addressCountry examples: HT (Haiti), GP (Guadeloupe), MQ (Martinique), JM (Jamaica), TT (Trinidad & Tobago)",

  "url": "https://link-to-your-content.com",

  "thumbnailUrl": "https://link-to-your-thumbnail.jpg",

  "_section_2": "=== CMS EXTENSION FIELDS (Caribbean Metadata Standard) ===",
  "_cms_note": "All cms: fields are CMS-specific. They extend schema.org without replacing it.",

  "cms:territory": "TERRITORY_NAME",
  "_cms:territory_options": ["Guadeloupe", "Martinique", "Haiti", "Jamaica", "Trinidad and Tobago", "Barbados", "Dominican Republic", "Cuba", "Puerto Rico", "Caribbean Diaspora", "Caribbean (multi-territory)"],

  "cms:environment": "ENVIRONMENT",
  "_cms:environment_options": ["Urban", "Rural", "Coastal", "Island", "Diaspora"],

  "cms:linguistic_marker": "PRIMARY_LANGUAGE_LABEL",
  "_cms:linguistic_marker_note": "Human-readable label e.g. 'Haitian Creole', 'Guadeloupe Creole', 'Jamaican Patois'",

  "cms:code_switching": "CODE_SWITCHING_PATTERN",
  "_cms:code_switching_options": ["FR/Kreyol", "EN/Patois", "ES/Creole", "Multilingual", "None"],

  "cms:narrative_genre": "GENRE",
  "_cms:narrative_genre_options": ["Magical realism", "Social drama", "Family saga", "Tropical thriller", "Documentary", "Comedy", "Coming-of-age", "Historical fiction"],

  "cms:cultural_markers": [
    "CULTURAL_MARKER_1",
    "CULTURAL_MARKER_2"
  ],
  "_cms:cultural_markers_note": "Free tags. Examples: Carnival, Vodou, Afro-Caribbean spirituality, Culinary heritage, Diaspora identity, Konpa",

  "cms:rhythmic_tempo": "TEMPO",
  "_cms:rhythmic_tempo_options": ["syncopated", "fast-paced urban", "slow contemplative island", "mixed"],

  "cms:sociohistorical_markers": [
    "MARKER_1",
    "MARKER_2"
  ],
  "_cms:sociohistorical_markers_note": "Examples: Postcolonial identity, Creolization, Memory of slavery, Intergenerational tensions, Migration",

  "cms:certification": "CERTIFICATION_LEVEL",
  "_cms:certification_options": ["Bronze", "Silver", "Gold", "Platinum"],
  "_cms:certification_note": "Assigned by the CMS certification process. Leave empty if not yet certified.",

  "cms:certification_date": "YYYY-MM-DD",

  "cms:standard_version": "CMS-2.0",

  "_section_3": "=== COMPLETED EXAMPLE (remove before use) ===",
  "_example": {
    "@context": {
      "@vocab": "https://schema.org/",
      "cms": "https://caribbeanmetadata.org/ns/"
    },
    "@type": "Movie",
    "name": "Anba Dlo",
    "description": "A documentary exploring Vodou spirituality and family memory across two generations in rural Haiti.",
    "creator": {
      "@type": "Person",
      "name": "Claudine Moreau",
      "sameAs": "https://claudinemoreau.ht"
    },
    "datePublished": "2024-06-01",
    "inLanguage": "ht",
    "keywords": ["haiti", "documentary", "vodou", "afro-caribbean-spirituality", "memory"],
    "contentLocation": {
      "@type": "Place",
      "name": "Haiti",
      "addressCountry": "HT"
    },
    "url": "https://example.com/anba-dlo",
    "cms:territory": "Haiti",
    "cms:environment": "Rural",
    "cms:linguistic_marker": "Haitian Creole",
    "cms:code_switching": "None",
    "cms:narrative_genre": "Documentary",
    "cms:cultural_markers": ["Vodou", "Afro-Caribbean spirituality", "Family memory"],
    "cms:rhythmic_tempo": "slow contemplative island",
    "cms:sociohistorical_markers": ["Postcolonial identity", "Memory of slavery", "Intergenerational tensions"],
    "cms:certification": "Gold",
    "cms:certification_date": "2026-05-01",
    "cms:standard_version": "CMS-2.0"
  }
}
